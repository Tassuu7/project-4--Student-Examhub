# ExamHub Environment Configuration Template
# Copy this file to .env.local for local development.
# Do not commit real production credentials or API keys to version control.

# Application Server
PORT=8001
HOST=127.0.0.1
DEBUG=True

# Security & Session Secrets (Replace with secure random strings in production)
EXAMHUB_SECRET_KEY="examhub-local-development-secret-key-change-in-production"
EXAMHUB_TOKEN_EXPIRE_MINUTES=720
EXAMHUB_SESSION_TIMEOUT=60

# Database Configuration
EXAMHUB_DB_PATH="backend/data/examhub.sqlite3"

# AI / External Services (Optional for extended capabilities)
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
